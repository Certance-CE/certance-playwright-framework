# ─── App under test ──────────────────────────────────────────────────────────
# The app *origin* (Page Objects navigate to their own paths). Defaults to the public
# Toolshop demo, which has a login and an API, so the showcase suite runs on a fresh
# clone with no credentials. Point this at your own app's origin to test that instead.
BASE_URL=https://practicesoftwaretesting.com

# The app's HTTP API. Used by the api fixture — including provisioning an isolated
# account for the auth setup project, so no credential is ever committed.
APP_API_URL=https://api.practicesoftwaretesting.com

# ─── Optional: apps that cannot provision accounts over an API ───────────────
# The showcase registers its own throwaway account each run, so it needs no credentials.
# If your app cannot do that, inject a user from your secret manager instead — never a
# value committed to the repo. See skills/core/auth.md.
# TEST_USER_EMAIL=qa-robot@example.com
# TEST_USER_PASSWORD=injected-at-runtime

# ─── Optional: API / contract tests (fixtures/api.fixture.ts) ────────────────
# Base URL of the app's HTTP API (defaults to BASE_URL if unset).
# APP_API_URL=https://api.your-app.com/
# Authorization header value (token). Without it, tests/api/* are skipped.
# APP_API_TOKEN=your-api-token

# ─── Optional: reproducible synthetic data (fixtures/data.fixture.ts) ────────
# Seed faker so data.realistic.* is identical across runs.
# FAKER_SEED=42

# ─── CI flag (set automatically by GitHub Actions) ───────────────────────────
# CI=true
