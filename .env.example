# ─── App under test ──────────────────────────────────────────────────────────
# The app *origin* (Page Objects navigate to their own paths). Defaults to the
# public TodoMVC demo host so `npm test` is green on a fresh clone. Point this at
# your own app's origin to test that instead.
BASE_URL=https://demo.playwright.dev

# ─── Optional: authenticated apps ────────────────────────────────────────────
# TodoMVC needs no login. For an app that does, capture a storageState once and
# wire it into the bdd project in playwright.config.ts (see skills/core/auth.md).
# Keep real credentials out of the repo — inject them via env / CI secrets only.
# TEST_USER_EMAIL=qa-robot@example.com
# TEST_USER_PASSWORD=replace-with-a-secret

# ─── Optional: API / contract tests (fixtures/api.fixture.ts) ────────────────
# Base URL of the app's HTTP API (defaults to BASE_URL if unset).
# APP_API_URL=https://api.your-app.com/
# Authorization header value (token). Without it, tests/api/* are skipped.
# APP_API_TOKEN=your-api-token

# ─── Optional: reproducible synthetic data (fixtures/data.fixture.ts) ────────
# Seed faker so data.realistic.* is identical across runs.
# FAKER_SEED=42

# ─── CI flag (set automatically by GitHub Actions) ───────────────────────────
# CI=true
